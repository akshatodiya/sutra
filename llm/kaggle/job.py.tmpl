def sample(model, r):
    # One n=1 call per sample: SGLang 0.5.4 parallel sampling (n>1) can exhaust request slots and kill the scheduler.
    # Explicit sampling: otherwise SGLang silently adds the model's generation_config (top_k, top_p, repetition_penalty).
    body = {"model": model, "messages": r["messages"], "n": 1, "temperature": r["temperature"], "max_tokens": r["max_tokens"],
            "top_p": 1.0, "top_k": -1, "repetition_penalty": 1.0}
    err = None
    for _ in range(3):
        try:
            c = post("/v1/chat/completions", body)["choices"][0]
            return c["message"]["content"], c.get("finish_reason")
        except Exception as e:
            err = repr(e)[:300]
            time.sleep(3)
    return None, err


def answer_all(model, ex):
    """Every sample of every request in flight at once (up to JOB['concurrency']), regrouped per request."""
    jobs = [r for r in REQUESTS for _ in range(r["n"])]
    got = iter(ex.map(lambda r: sample(model, r), jobs))
    for r in REQUESTS:
        res = [next(got) for _ in range(r["n"])]
        row = {"id": r["id"], "meta": r["meta"], "outputs": [t for t, _ in res if t is not None],
               "finish": [f for t, f in res if t is not None]}
        errs = [f for t, f in res if t is None]
        if errs:
            row["error"] = errs[0]
        yield row


for m in models:
    info = run["models"][m["name"]] = {"path": m["path"]}
    cmd = [PY, "-m", "sglang.launch_server", "--model-path", m["path"], "--tokenizer-path", m.get("tokenizer", m["path"]),
           "--dtype", "half", "--port", "30000",
           "--tp", str(JOB["tp"]), "--mem-fraction-static", str(JOB["mem"]), "--context-length", str(JOB["ctx"]),
           *JOB["server_flags"]]
    srv = subprocess.Popen(cmd, stdout=open(f"{OUT}/server_{m['name']}.log", "w"), stderr=subprocess.STDOUT)
    t = time.time()
    while time.time() - t < 1200 and srv.poll() is None and "up_seconds" not in info:
        time.sleep(5)
        try:
            urllib.request.urlopen("http://127.0.0.1:30000/health", timeout=5)
            info["up_seconds"] = round(time.time() - t)
        except Exception:
            pass
    save()
    if "up_seconds" in info:
        t = time.time()
        with open(f"{OUT}/outputs_{m['name']}.jsonl", "w") as f, ThreadPoolExecutor(JOB["concurrency"]) as ex:
            for row in answer_all(m["path"], ex):
                f.write(json.dumps(row) + "\n")
                if "error" in row:
                    info["errors"] = info.get("errors", 0) + 1
        info["gen_seconds"] = round(time.time() - t)
    srv.terminate()
    try:
        srv.wait(60)
    except subprocess.TimeoutExpired:
        srv.kill()
    save()
run["total_seconds"] = round(time.time() - t0)
save()
print(json.dumps(run, indent=1, default=str)[:3000])
