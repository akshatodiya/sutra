# Outputs in /kaggle/working: outputs_<model>.jsonl, run.json, logs.
import json, os, signal, subprocess, sys, time, urllib.request
from concurrent.futures import ThreadPoolExecutor

OUT = os.environ.get("SUTRA_OUT", "/kaggle/working")
os.makedirs(OUT, exist_ok=True)
JOB = json.loads(r'''__JOB__''')
REQUESTS = json.loads(r'''__REQUESTS__''')
TRAIN = json.loads(r'''__TRAIN__''')  # {} or {"student", "hparams", "sets": {name: [messages rows]}}
VENV = "/kaggle/tmp/sgl"
PY = f"{VENV}/bin/python"
run = {"job": JOB, "n_requests": len(REQUESTS), "models": {}, "hparams": TRAIN.get("hparams")}
t0 = time.time()
os.makedirs("/kaggle/tmp", exist_ok=True)


def save():
    json.dump(run, open(f"{OUT}/run.json", "w"), indent=1)


def sh(cmd, log):
    with open(f"{OUT}/{log}", "w") as f:
        return subprocess.run(cmd, shell=True, stdout=f, stderr=subprocess.STDOUT).returncode


def post(path, body, timeout=600):
    req = urllib.request.Request(f"http://127.0.0.1:30000{path}", json.dumps(body).encode(),
                                 {"Content-Type": "application/json"})
    return json.load(urllib.request.urlopen(req, timeout=timeout))


# ---- training (AlignTune, Kaggle's own Python) ----
TRAIN_ONE = r"""
import json, os, sys
from aligntune.core.backend_factory import create_sft_trainer
from aligntune.core.merge.peft_merger import PEFTMerger
name, student, hp = sys.argv[1], sys.argv[2], json.loads(sys.argv[3])
out = os.environ.get("SUTRA_OUT", "/kaggle/working")
trainer = create_sft_trainer(model_name=student, dataset_name=f"/kaggle/tmp/{name}.jsonl", backend="trl",
                             output_dir=f"{out}/adapters/{name}", use_peft=True, **hp)
print(json.dumps(trainer.train(), default=str)[:2000])
# Check the resolved native trainer, rather than assuming the factory accepted every setting.
native = trainer.trainer
args = native.args
expected = {"num_train_epochs": hp["num_epochs"], "max_steps": hp["max_steps"],
            "per_device_train_batch_size": hp["batch_size"], "gradient_accumulation_steps": hp["gradient_accumulation_steps"],
            "learning_rate": hp["learning_rate"], "max_length": hp["max_seq_length"], "seed": hp["seed"],
            "fp16": False, "bf16": False, "assistant_only_loss": hp.get("assistant_only_loss", False)}
actual = {k: getattr(args, k) for k in expected}
assert actual == expected, (actual, expected)
assert abs(native.state.epoch - hp["num_epochs"]) < 0.01, native.state.epoch
peft = native.model.peft_config["default"]
assert (peft.r, peft.lora_alpha, peft.lora_dropout) == (hp["lora_r"], hp["lora_alpha"], hp["lora_dropout"])
assert all(str(p.dtype) == "torch.float32" for p in native.model.parameters() if p.requires_grad)
masked = supervised = 0
for row in native.train_dataset:
    batch = native.data_collator([row])
    ids, labels = batch["input_ids"][0].tolist(), batch["labels"][0].tolist()
    assert len(ids) <= hp["max_seq_length"]
    assert all(y == -100 or y == x for x, y in zip(ids, labels))
    assert any(y != -100 for y in labels), "answer entirely masked"
    if hp.get("assistant_only_loss"):
        assert labels[0] == -100 and any(row["assistant_masks"]), "prompt masking missing"
        assert all(y == -100 for y, m in zip(labels, row["assistant_masks"]) if not m)
    masked += sum(y == -100 for y in labels)
    supervised += sum(y != -100 for y in labels)
json.dump({"args": actual, "epoch": native.state.epoch, "global_step": native.state.global_step,
           "masked_tokens": masked, "supervised_tokens": supervised}, open(f"{out}/training_check_{name}.json", "w"), indent=1)
PEFTMerger().merge_lora(base_model=student, adapter_path=f"{out}/adapters/{name}",
                        output_path=f"/kaggle/tmp/merged/{name}", torch_dtype="float16")
# The merger writes a transformers-5 config (rope_theta inside rope_parameters). SGLang 0.5.4 runs transformers
# 4.57, misses it and silently uses rope_theta=10000. LoRA leaves the architecture unchanged: reuse the base config.
import shutil
from huggingface_hub import hf_hub_download
shutil.copy(hf_hub_download(student, "config.json"), f"/kaggle/tmp/merged/{name}/config.json")
"""
models = [{"name": m.split("/")[-1], "path": m} for m in JOB["models"]]
if TRAIN:
    open("/kaggle/tmp/train_one.py", "w").write(TRAIN_ONE)
    run["train_pip_rc"] = sh(f"pip install -q {JOB['train_pip']}", "train_pip.log")
    run["train_versions"] = subprocess.run("pip list 2>/dev/null | grep -i -E '^(torch|transformers|trl|peft|accelerate|datasets|torchao|aligntune|curatorkit) '",
                                           shell=True, capture_output=True, text=True).stdout
    save()
    if run["train_pip_rc"] != 0:
        sys.exit("training dependencies failed")
    sh(f"{sys.executable} -m pip freeze", "train_freeze.txt")
    for name, rows in TRAIN["sets"].items():
        with open(f"/kaggle/tmp/{name}.jsonl", "w") as f:
            f.writelines(json.dumps(r) + "\n" for r in rows)
        t = time.time()
        rc = subprocess.run([sys.executable, "/kaggle/tmp/train_one.py", name, TRAIN["student"], json.dumps(TRAIN["hparams"])],
                            stdout=open(f"{OUT}/train_{name}.log", "w"), stderr=subprocess.STDOUT,
                            env={**os.environ, "CUDA_VISIBLE_DEVICES": "0"}).returncode  # one GPU, no DataParallel
        run.setdefault("train", {})[name] = {"rc": rc, "rows": len(rows), "seconds": round(time.time() - t)}
        save()
        if rc != 0:
            sys.exit(f"training {name} failed, see train_{name}.log")  # never report a partial experiment
        # LoRA leaves the tokenizer unchanged; the merged dir may lack tokenizer.json, so serve with the base one.
        models.append({"name": name, "path": f"/kaggle/tmp/merged/{name}", "tokenizer": TRAIN["student"]})

# ---- serving (SGLang in a uv Python 3.12 venv) ----
# sgl-kernel ships no sm_75 (T4) code, so route every SGLang CustomOp to its PyTorch forward_native.
PATCH = r"""
import pathlib, sys
p = next(pathlib.Path(sys.argv[1]).glob("lib/python3*/site-packages/sglang/srt/custom_op.py"))
old = "        if _is_cuda:\n            return self.forward_cuda\n"
s = p.read_text()
assert old in s
p.write_text(s.replace(old, "        if _is_cuda:\n            return self.forward_native\n", 1))
"""
open("/kaggle/tmp/patch.py", "w").write(PATCH)
if os.path.exists(PY):
    run["sglang_pip_rc"] = 0  # earlier phase of this same private kernel already installed and patched it
else:
    run["sglang_pip_rc"] = sh(f"pip install -q uv && uv venv -q -p 3.12 {VENV} && "
                              f"uv pip install -q -p {PY} {JOB['sglang']} && {PY} /kaggle/tmp/patch.py {VENV}", "sglang_pip.log")
save()
run["sglang_versions"] = subprocess.run(f"uv pip list -p {PY} 2>/dev/null | grep -i -E '^(sglang|sgl-kernel|torch|transformers|flashinfer-python) '",
                                        shell=True, capture_output=True, text=True).stdout
if run["sglang_pip_rc"] != 0:
    sys.exit("sglang install failed")
if sh(f"{PY} -m pip freeze", "sglang_freeze.txt") != 0:
    # uv venvs need not have pip installed.
    sh(f"uv pip freeze -p {PY}", "sglang_freeze.txt")


