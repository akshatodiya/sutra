# Generated by build.py: the complete current Sutra chain.
import ast
import base64
from collections import Counter
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tarfile
import time
import urllib.request

BUNDLE = json.loads(base64.b64decode("__BUNDLE__"))
ROOT = Path("/kaggle/tmp/sutra")
OUT = Path("/kaggle/working/latest")
START = time.time()
STATE = {"status": "running", "source_hashes": BUNDLE["hashes"], "hparams": BUNDLE["hparams"], "stages": {}}


def save():
    STATE["seconds"] = round(time.time() - START)
    tmp = OUT / "pipeline.json.tmp"
    tmp.write_text(json.dumps(STATE, indent=1))
    tmp.replace(OUT / "pipeline.json")


def run(name, argv, env=None):
    STATE["current"] = name
    save()
    start = time.time()
    with (OUT / f"{name}.log").open("w") as log:
        rc = subprocess.run(argv, stdout=log, stderr=subprocess.STDOUT, env=env, cwd=ROOT).returncode
    STATE["stages"][name] = {"rc": rc, "seconds": round(time.time() - start)}
    save()
    if rc:
        raise RuntimeError(f"{name} failed ({rc}), see {name}.log")


def rows(path):
    return [json.loads(l) for l in path.read_text().splitlines()]


def stage(name, requests, train=None):
    out = OUT / name
    out.mkdir()
    script = (ROOT / "llm/kaggle/job.py.tmpl").read_text()
    for key, value in {"JOB": BUNDLE["jobs"][name], "REQUESTS": requests, "TRAIN": train or {}}.items():
        script = script.replace("r'''__" + key + "__'''", repr(json.dumps(value)))
    ast.parse(script)
    (out / "job.py").write_text(script)
    run(name, [sys.executable, str(out / "job.py")], {**os.environ, "SUTRA_OUT": str(out), "WANDB_MODE": "disabled"})
    return out


def verify(out, name, requests, dest):
    src = out / f"outputs_{name}.jsonl"
    actual = rows(src)
    assert len(actual) == len(requests), "missing or extra requests"
    for r, ref in zip(actual, requests):
        assert r["id"] == ref["id"] and r["meta"] == ref["meta"], "misaligned requests"
        assert "error" not in r and len(r["outputs"]) == len(r["finish"]) == ref["n"], "partial generation"
        assert all(isinstance(s, str) for s in r["outputs"]), "non-text generation"
    run(f"verify_{out.name}_{name}", [sys.executable, "llm/verify.py", str(src), str(dest)])


def install_node():
    # Use a pinned Node binary for the identical, bundled interpreter.
    filename = "node-v20.19.5-linux-x64.tar.xz"
    archive = ROOT / filename
    urllib.request.urlretrieve("https://nodejs.org/dist/v20.19.5/" + filename, archive)
    assert hashlib.sha256(archive.read_bytes()).hexdigest() == "315046739a513a70e03a4a55a8afda8cf979f30852e576075c340084e3f8ac0f"
    with tarfile.open(archive) as tar:
        tar.extractall(ROOT, filter="data")
    archive.unlink()
    os.environ["PATH"] = str(ROOT / "node-v20.19.5-linux-x64/bin") + os.pathsep + os.environ["PATH"]
    run("node", ["node", "--version"])


def main():
    ROOT.mkdir(parents=True, exist_ok=True)
    OUT.mkdir(parents=True, exist_ok=False)
    for rel, text in BUNDLE["files"].items():
        path = ROOT / rel
        assert path.resolve().is_relative_to(ROOT.resolve())
        assert hashlib.sha256(text.encode()).hexdigest() == BUNDLE["hashes"][rel]
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text)
    (OUT / "plan.json").write_text(json.dumps({k: v for k, v in BUNDLE.items() if k != "files"}, indent=1))
    run("hardware", ["nvidia-smi"])
    run("toolkits", [sys.executable, "-m", "pip", "install", "-q", "curatorkit==0.1.22", "auditkit==1.1.3"])
    install_node()

    requests = BUNDLE["teacher_requests"]
    gen = stage("teacher_gen", requests)
    model = BUNDLE["jobs"]["teacher_gen"]["models"][0].split("/")[-1]
    verify(gen, model, requests, gen / "verified.jsonl")
    sys.path.insert(0, str(ROOT / "llm"))
    import prompts
    tasks = {t["id"]: t for t in rows(ROOT / "llm/data/tasks_train.jsonl")}
    original = {r["meta"]["task_id"]: r["messages"][0] for r in requests if r["meta"]["split"] == "train"}
    repair = []
    for v in rows(gen / "verified.jsonl"):
        if v["split"] != "train" or v["ok"]:
            continue
        msgs = prompts.repair_messages(tasks[v["task_id"]], v["program"], v["check"])
        msgs[0] = original[v["task_id"]]
        repair.append({"id": f"repair:{v['id']}", "meta": {"task_id": v["task_id"], "split": "train", "repair_of": v["id"]},
                       "messages": msgs, "n": 1, "temperature": 0.2, "max_tokens": 512})
    if repair:
        fixed = stage("teacher_repair", repair)
        verify(fixed, model, repair, fixed / "verified.jsonl")
    else:
        fixed = OUT / "teacher_repair"
        fixed.mkdir()
        (fixed / "verified.jsonl").write_text("")
    sft = OUT / "sft"
    run("curate", [sys.executable, "llm/curate.py", str(gen / "verified.jsonl"), str(fixed / "verified.jsonl"), str(sft)])
    sets = {s: rows(sft / s / "sft_messages.jsonl") for s in ("raw", "curated")}
    assert sets["raw"] and len(sets["raw"]) == len(sets["curated"])
    counts = []
    for data in sets.values():
        for row in data:
            msgs = row["messages"]
            assert [m["role"] for m in msgs] == ["user", "assistant"]
            assert msgs[0]["content"] in {prompts.user_prompt(t) for t in tasks.values()}, "non-training prompt"
            assert msgs[1]["content"].startswith("```sutra\n") and msgs[1]["content"].endswith("\n```")
        counts.append(Counter(r["messages"][0]["content"] for r in data))
    assert counts[0] == counts[1], "raw/curated prompt counts differ"
    scored = stage("train_eval", BUNDLE["eval_requests"],
                   {"student": BUNDLE["student"], "hparams": BUNDLE["hparams"], "sets": sets})
    for name in (BUNDLE["student"].split("/")[-1], "raw", "curated"):
        verify(scored, name, BUNDLE["eval_requests"], scored / f"verified_{name}.jsonl")
    run("evaluate", [sys.executable, "llm/evaluate.py", str(scored)])
    run("best_of_k", [sys.executable, "llm/best_of_k.py", str(scored)])
    run("versions", [sys.executable, "-m", "pip", "freeze"])
    STATE["status"] = "complete"
    save()


if __name__ == "__main__":
    try:
        main()
    except BaseException as exc:
        STATE.update(status="failed", error=repr(exc))
        if OUT.is_dir():
            save()
        raise
