      { "model": "curated", "program": "solve xs = length (filter (\\x -> x < 0) xs)", "verdict": "pass" }
    ]
  },
  {
    "task": "Reverse the elements of xs.",
    "expr": "solve [1, 2, 3]",
    "expect": "[3, 2, 1]",
    "answers": [
      { "model": "base", "program": "solve xs = reverse xs", "verdict": "pass" },
